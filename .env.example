# ============================================================
# Unity-Python 강화학습 설정 (.env.example)
# 이 파일을 .env 로 복사해서 사용한다. 모든 키는 필수이며 코드에 기본값이 없다.
# ============================================================

# ---------- 학습 ----------
# 총 학습 에피소드 수 (재개(--resume) 시에도 "목표 총 에피소드"로 해석)
TOTAL_EPISODES=1500
# 에피소드 최대 step (초과 시 truncated)
MAX_STEPS_PER_EPISODE=200
SEED=42
# sac | td3
ALGORITHM=sac
# auto | cuda | cpu
DEVICE=auto

# ---------- 하이퍼파라미터 (공통) ----------
LEARNING_RATE=0.0003
GAMMA=0.99
TAU=0.005
BATCH_SIZE=256
BUFFER_SIZE=200000
# 이 step 수까지는 무작위 행동으로 데이터 수집
WARMUP_STEPS=2000
HIDDEN_UNITS=256
# UPDATE_EVERY step 마다 UPDATES_PER_CYCLE 회 gradient update
UPDATE_EVERY=1
UPDATES_PER_CYCLE=1

# ---------- SAC ----------
SAC_INIT_ALPHA=0.2
# 목표 엔트로피 (일반적으로 -action_dim)
SAC_TARGET_ENTROPY=-2.0

# ---------- TD3 ----------
TD3_EXPLORATION_NOISE=0.1
TD3_POLICY_NOISE=0.2
TD3_NOISE_CLIP=0.5
TD3_POLICY_DELAY=2

# ---------- 환경 파라미터 (Unity 로 전달) ----------
FLOOR_SIZE=10.0
MIN_SPAWN_DISTANCE=3.0
SPAWN_MARGIN=1.0
MAX_FORCE=10.0
MAX_SPEED=10.0
FALL_Y=-1.0
# 한 번의 action 을 유지하는 물리 tick 수
DECISION_INTERVAL=5
FIXED_DT=0.02
SPHERE_MASS=1.0
SPHERE_DRAG=1.0
SPHERE_ANGULAR_DRAG=0.5
# 학습 중 Unity step 속도 제한 (0 = 무제한, 최고 속도)
TRAIN_STEPS_PER_SEC=0
# 평가/관찰 모드 속도 (0 = 무제한, 10 = 실시간 느낌)
EVAL_STEPS_PER_SEC=10

# ---------- Reward ----------
W_APPROACH=1.0
R_SUCCESS=10.0
R_FALL=10.0
C_STEP=0.01
C_ACTION=0.001

# ---------- Unity 연결 ----------
UNITY_HOST=127.0.0.1
UNITY_PORT=5005
CONNECT_TIMEOUT=10
STEP_TIMEOUT=10
RECONNECT_RETRIES=5
# 빌드된 Unity 실행 파일 (비워두면 자동 실행 안 함: 에디터에서 Play 하거나 직접 실행)
UNITY_EXE=Builds/RLEnv/RLEnv.exe
# 연결 실패 시 UNITY_EXE 를 자동 실행 (1/0)
UNITY_AUTOLAUNCH=1
# 자동 실행 시 창 없이 실행 (1: 헤드리스, 0: 창 표시)
UNITY_HEADLESS=0

# ---------- 저장 / 로그 ----------
RUNS_DIR=runs
CHECKPOINT_EVERY=100
# 결정론적 평가 주기(에피소드)와 평가 에피소드 수 (Best Model 선정 기준)
EVAL_EVERY=50
EVAL_EPISODES=10
# 이동 평균/성공률 윈도우
MA_WINDOW=50
